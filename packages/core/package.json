{
  "name": "@kalahroudi/bulkhead-core",
  "version": "0.1.0-preview.0",
  "description": "Bulkhead runtime: tenant resolution, tenant-scoped storage handle, policy-gated routes.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./tenant": "./src/tenant/index.ts",
    "./api": "./src/api/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "build": "node ../../scripts/build-package.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "hono": "^4.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalahroudi/bulkhead.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/kalahroudi/bulkhead#readme",
  "bugs": {
    "url": "https://github.com/kalahroudi/bulkhead/issues"
  },
  "keywords": [
    "bulkhead",
    "multi-tenant",
    "cloudflare-workers",
    "durable-objects",
    "security"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "tag": "preview",
    "exports": {
      "./tenant": {
        "types": "./dist/tenant/index.d.ts",
        "default": "./dist/tenant/index.js"
      },
      "./api": {
        "types": "./dist/api/index.d.ts",
        "default": "./dist/api/index.js"
      }
    }
  }
}
